@ECHO OFF
REM ===========================================================================
REM FreeDOS Unattended OEM Setup Script for Bento / Packer
REM Partitions C:, formats FAT16/FAT32 with system files, installs FreeDOS base
REM and Bento Serial/Telnet Agent, and powers off cleanly.
REM ===========================================================================

ECHO ===BENTO_FREEDOS_INSTALL_START===
IF NOT EXIST C:\KERNEL.SYS FDISK /AUTO 1
IF NOT EXIST C:\KERNEL.SYS FORMAT C: /S /U /V:FREEDOS < A:\YES.TXT

IF NOT EXIST C:\FDOS MKDIR C:\FDOS
IF NOT EXIST C:\FDOS\BIN MKDIR C:\FDOS\BIN
IF NOT EXIST C:\BENTO MKDIR C:\BENTO
IF NOT EXIST C:\TEMP MKDIR C:\TEMP

COPY /Y A:\FDCONFIG.SYS C:\FDCONFIG.SYS
COPY /Y A:\FDAUTO.BAT C:\FDAUTO.BAT
COPY /Y A:\VAGAGENT.BAT C:\BENTO\VAGAGENT.BAT
COPY /Y A:\RUNCMD.BAT C:\BENTO\RUNCMD.BAT
IF EXIST A:\B64DEC.COM COPY /Y A:\B64DEC.COM C:\BENTO\B64DEC.COM
IF EXIST A:\B64ENC.COM COPY /Y A:\B64ENC.COM C:\BENTO\B64ENC.COM

ECHO ===BENTO_FREEDOS_INSTALL_COMPLETE===
IF EXIST C:\FDOS\BIN\FDAPM.COM C:\FDOS\BIN\FDAPM.COM POWEROFF
